# ── OAuth provider ──────────────────────────────────────────────────────────
# Who issues human logins. Create an OAuth app first:
#   github: https://github.com/settings/developers  (callback URL:
#          https://<your-domain>/auth/callback)
#   google: https://console.cloud.google.com/apis/credentials (authorized
#          redirect URI: https://<your-domain>/auth/callback, scope: openid,
#          .../auth/userinfo.email)
MCP_AUTH_PROVIDER=github            # github | google
MCP_BASE_URL=https://vault-mcp.example.com   # public HTTPS root, no trailing /mcp
MCP_REDIRECT_PATH=/auth/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# For MCP_AUTH_PROVIDER=google use these instead:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Who may actually use the server (authorization on top of authentication).
# GitHub logins or Google emails, comma-separated. EMPTY = nobody gets in
# (fail closed); static machine tokens are unaffected.
MCP_ALLOWED_USERS=your-github-login

# Signs the client tokens the server issues, so logins survive restarts.
# Generate once: openssl rand -hex 32
MCP_JWT_SIGNING_KEY=

# ── Vault ───────────────────────────────────────────────────────────────────
# Host path of your Obsidian vault (the folder with .obsidian/ inside).
HOST_VAULT=/path/to/your/vault
# Where create_note drops notes when no folder is given.
VAULT_INBOX_REL=Inbox
# Folders hidden from listing/search (comma-separated folder names).
VAULT_EXCLUDE_DIRS=.obsidian,.git,.trash
TZ=UTC

# ── Behaviour (optional) ────────────────────────────────────────────────────
# MCP_READONLY=true            # refuse every mutating tool
# MCP_GITHUB_TOKEN_CACHE_TTL=300
# MCP_LOG_LEVEL=INFO

# ── Static machine-account tokens (optional) ────────────────────────────────
# Host dir with the static-tokens hash file (mounted read-only into the
# container as /etc/vault-mcp). See docs/static-tokens.md.
# HOST_MCP_CONF=./data/conf
